rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsWorld(worldId) {
      return signedIn() &&
        get(/databases/$(database)/documents/worlds/$(worldId)).data.ownerUid == request.auth.uid;
    }

    match /worlds/{worldId} {
      // Public reads make discoverable worlds possible in the startup picker.
      allow read: if true;

      // Anonymous Auth creates a stable invisible UID in the browser.
      // A world can only be created/updated by its owner.
      allow create: if signedIn() &&
        request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if signedIn() &&
        resource.data.ownerUid == request.auth.uid &&
        request.resource.data.ownerUid == resource.data.ownerUid;

      match /{document=**} {
        allow read: if true;
        allow create, update, delete: if ownsWorld(worldId);
      }
    }

    match /catalogs/{catalogId} {
      allow read: if true;
      allow create: if signedIn();
      allow update, delete: if false;
    }
  }
}
