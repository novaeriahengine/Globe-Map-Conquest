rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Worlds are readable by the browser so the world picker can list public worlds.
    // Writes require Firebase Anonymous Auth. There is no visible login screen.
    match /worlds/{worldId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;

      match /{document=**} {
        allow read: if true;
        allow create, update, delete: if request.auth != null;
      }
    }

    match /catalogs/{catalogId} {
      allow read: if true;
      allow create, update: if request.auth != null;
      allow delete: if false;
    }
  }
}
